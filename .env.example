# Generate three distinct keys with `uv run python -m app.setup keys`.
ADMIN_KEY=
STATION_1_KEY=
STATION_2_KEY=
# For a local app using Supabase: use its restricted login and session pooler.
# DATABASE_URL=postgresql+psycopg://APP_ROLE.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=ENCODED_ABSOLUTE_CERT_PATH&connect_timeout=10
# Keep the web server restricted to this computer.
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
